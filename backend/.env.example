# Database
DATABASE_URL=postgresql://user:password@localhost:5432/wattaman
CONTROL_PLANE_DATABASE_URL=
RLS_RUNTIME_DATABASE_URL=
RLS_CONTROL_PLANE_DATABASE_URL=
# One-time infrastructure administration only; never configure on API/worker services.
DATABASE_ADMIN_URL=
TENANT_TRANSACTION_MAX_WAIT_MS=5000
TENANT_TRANSACTION_TIMEOUT_MS=30000

# Auth
JWT_SECRET=change-me-in-production-use-a-strong-random-key
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d
COOKIE_SECURE=false

# CORS — comma-separated list of allowed origins (dev defaults to localhost:3000/3004 if unset)
CORS_ORIGINS=http://localhost:3000,http://localhost:3004

# Multi-tenancy — the reserved host for the Platform tier (marketing site + PLATFORM_ADMIN login).
# Requests on this host are NOT resolved against the School table; every other host is looked up
# as a school subdomain or custom domain. See docs/multi-tenant-ux-ui.md and the conversion plan.
PLATFORM_HOST=app.wattaman.app

# Root domain school subdomains live under (e.g. greenhill.wattaman.app) — used by the CORS
# allowlist in main.ts to recognize our own subdomains by shape, and by AuthService to build
# per-school password-reset links (https://<school-subdomain>.$SCHOOL_ROOT_DOMAIN/reset-password).
SCHOOL_ROOT_DOMAIN=wattaman.app

# Railway domain automation (optional — school creation/deletion degrades to a
# manual "add a Railway domain by hand" step if unset). This deployment has no
# wildcard DNS, so each school needs its own <subdomain>.up.railway.app domain
# registered before it's reachable — see Phase 18 of the conversion plan.
# RAILWAY_ENVIRONMENT_ID and RAILWAY_PROJECT_ID are auto-injected by Railway
# itself in production; only these two need to be set by hand:
RAILWAY_API_TOKEN=
RAILWAY_FRONTEND_SERVICE_ID=

# Private Cloudflare R2 storage for extension quarantine and published assets.
# R2_ENDPOINT is optional when R2_ACCOUNT_ID is set.
R2_ACCOUNT_ID=
R2_ENDPOINT=
R2_BUCKET=wattaman-extensions
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

# Maximum synchronous package-validation duration before a persisted failure.
EXTENSION_VALIDATION_TIMEOUT_MS=30000
EXTENSION_VALIDATION_MEMORY_MB=64
EXTENSION_VALIDATION_STACK_MB=4

# Set false to atomically hide all versioned extension APIs while legacy
# AddonDefinition/SchoolAddon reads remain available for rollback.
EXTENSION_PLATFORM_ENABLED=true

# Idempotency-Key reservation TTL for mutating APIs (docs/api-idempotency.md).
IDEMPOTENCY_TTL_MS=86400000

# Distributed per-school/extension command lock TTL, held for the duration of
# an install/upgrade/rollback/uninstall/purge job (docs/extension-lifecycle-jobs.md).
EXTENSION_COMMAND_LOCK_MS=120000

# Stale-claim window: how long an extension lifecycle job may sit RUNNING
# before a retry is allowed to reclaim and re-execute it (docs/extension-lifecycle-jobs.md).
EXTENSION_LIFECYCLE_STALE_MS=300000

# Ed25519 package signing. Store the PKCS8 private PEM as base64; only the
# corresponding public key is registered in PostgreSQL.
EXTENSION_SIGNING_KEY_ID=
EXTENSION_SIGNING_PRIVATE_KEY_BASE64=

# Package retention defaults. Abandoned quarantine jobs become rejected after
# seven days; rejected bytes/assets are removed after another 30 days while
# validation reports and checksums remain. Cleanup processes at most 100 rows.
EXTENSION_QUARANTINE_RETENTION_DAYS=7
EXTENSION_REJECTED_RETENTION_DAYS=30
EXTENSION_RETENTION_BATCH_SIZE=100

# Grace period between an uninstall and the scheduled hard-delete purge.
EXTENSION_UNINSTALL_GRACE_DAYS=30

# Platform-owned Ed25519 key for signing purge/audit reports. Distinct trust
# domain from EXTENSION_SIGNING_* (publisher package signing) — do not reuse
# those keys here. See docs/extension-lifecycle-jobs.md.
EXTENSION_PURGE_REPORT_KEY_ID=
EXTENSION_PURGE_REPORT_PRIVATE_KEY_BASE64=
EXTENSION_PURGE_REPORT_PUBLIC_KEY_BASE64=

# Defaults to enabled when NODE_ENV=production. Set false only for an explicitly
# accepted single-operator workflow.
EXTENSION_REVIEW_SEPARATION_REQUIRED=true

# Notifications (optional — features degrade gracefully if unset)
SENDGRID_API_KEY=
SENDGRID_FROM=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# Distributed external-dependency circuit breakers. REDIS_URL is mandatory in
# production and shared by every API and worker replica.
REDIS_URL=
QUEUE_JOB_ATTEMPTS=8
QUEUE_JOB_BACKOFF_MS=1000
CIRCUIT_BREAKER_FAILURE_THRESHOLD=5
CIRCUIT_BREAKER_RESET_TIMEOUT_MS=30000

PORT=3001
NODE_ENV=development
