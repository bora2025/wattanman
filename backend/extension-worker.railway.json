{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "DOCKERFILE",
    "dockerfilePath": "Dockerfile",
    "watchPatterns": ["src/**", "prisma/**", "package*.json", "Dockerfile"]
  },
  "deploy": {
    "preDeployCommand": "node prisma/check-schema-compatibility.js",
    "startCommand": "node dist/extension-worker",
    "healthcheckPath": "/ready",
    "healthcheckTimeout": 30,
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 10
  }
}
