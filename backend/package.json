{
  "name": "backend",
  "version": "0.0.1",
  "description": "SchoolSync API Backend",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "build": "nest build",
    "dev": "nest start --watch",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main",
    "start:worker": "node dist/worker",
    "start:extension-worker": "node dist/extension-worker",
    "start:notification-worker": "node dist/notification-worker",
    "postinstall": "prisma generate --schema=prisma/schema.prisma",
    "db:push": "prisma db push --schema=prisma/schema.prisma",
    "db:migrate:bootstrap": "node prisma/bootstrap-migrations.js",
    "db:migrate:adopt": "node prisma/bootstrap-migrations.js --adopt-existing",
    "db:migrate:release": "node prisma/release-migrate.js",
    "db:schema:check": "node prisma/check-schema-compatibility.js",
    "db:roles:provision": "node prisma/provision-database-roles.js",
    "db:rls:activate": "node prisma/activate-tenant-rls.js",
    "db:provisioning:rehearse": "node prisma/rehearse-school-provisioning.js",
    "db:restore:rehearse": "node dist/cli/rehearse-school-restore.js",
    "incident:rehearse": "node dist/cli/rehearse-incident-response.js",
    "storage:r2:cors": "node scripts/configure-r2-cors.js",
    "db:seed": "ts-node prisma/seed.ts",
    "extension:validate": "ts-node src/cli/validate-extension-package.ts",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "test:e2e": "jest --config ./test/jest-e2e.json",
    "test:isolation": "jest --config ./test/jest-e2e.json --runInBand test/tenant-isolation.e2e-spec.ts",
    "test:lifecycle": "jest --config ./test/jest-e2e.json --runInBand test/extension-lifecycle.e2e-spec.ts",
    "test:database-scope": "jest --config ./test/jest-e2e.json --runInBand test/tenant-database-scope.e2e-spec.ts",
    "test:database-identities": "jest --config ./test/jest-e2e.json --runInBand test/database-identities.e2e-spec.ts",
    "test:rls": "jest --config ./test/jest-e2e.json --runInBand test/tenant-rls.e2e-spec.ts"
  },
  "dependencies": {
    "@nestjs/common": "^10.0.0",
    "@nestjs/core": "^10.0.0",
    "@nestjs/jwt": "^10.0.0",
    "@nestjs/passport": "^10.0.0",
    "@nestjs/platform-express": "^10.0.0",
    "@nestjs/schedule": "^4.0.0",
    "@nestjs/throttler": "^6.5.0",
    "@nestjs/websockets": "^10.0.0",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/auto-instrumentations-node": "^0.79.0",
    "@opentelemetry/exporter-trace-otlp-proto": "^0.221.0",
    "@opentelemetry/resources": "^2.10.0",
    "@opentelemetry/sdk-node": "^0.221.0",
    "@opentelemetry/semantic-conventions": "^1.43.0",
    "@prisma/client": "^5.22.0",
    "@sendgrid/mail": "^8.0.0",
    "ajv": "^8.17.1",
    "bcryptjs": "^2.4.3",
    "bullmq": "^6.0.11",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "compression": "^1.8.1",
    "cookie-parser": "^1.4.7",
    "helmet": "^8.1.0",
    "ioredis": "^6.0.0",
    "jszip": "^3.10.1",
    "otplib": "^12.0.1",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "reflect-metadata": "^0.2.0",
    "rxjs": "^7.8.1",
    "twilio": "^5.0.0"
  },
  "devDependencies": {
    "@nestjs/cli": "^10.0.0",
    "@nestjs/schematics": "^10.0.0",
    "@nestjs/testing": "^10.0.0",
    "@swc/cli": "^0.8.0",
    "@swc/core": "^1.15.21",
    "@types/bcryptjs": "^2.4.3",
    "@types/compression": "^1.8.1",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^4.17.17",
    "@types/jest": "^29.5.2",
    "@types/multer": "^2.1.0",
    "@types/node": "^20.3.1",
    "@types/passport-jwt": "^4.0.0",
    "@types/supertest": "^6.0.0",
    "@typescript-eslint/eslint-plugin": "^6.0.0",
    "@typescript-eslint/parser": "^6.0.0",
    "eslint": "^8.42.0",
    "eslint-config-prettier": "^9.0.0",
    "eslint-plugin-prettier": "^5.0.0",
    "jest": "^29.5.0",
    "prettier": "^3.0.0",
    "prisma": "^5.22.0",
    "source-map-support": "^0.5.21",
    "supertest": "^6.3.3",
    "ts-jest": "^29.1.0",
    "ts-loader": "^9.4.3",
    "ts-node": "^10.9.1",
    "typescript": "^5.1.3"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "collectCoverageFrom": [
      "**/*.(t|j)s"
    ],
    "coverageDirectory": "../coverage",
    "testEnvironment": "node"
  }
}
