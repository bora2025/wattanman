  scoreSheetId String
  scoreSheet   ScoreSheet @relation(fields: [scoreSheetId], references: [id], onDelete: Cascade)
  label        String // e.g., "January", "Q1", "Semester 1"
  type         String // MONTHLY | QUARTERLY | SEMESTER
  order        Int        @default(0)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  entries ScoreEntry[]

  @@index([schoolId])
}

model ScoreEntry {
  id        String       @id @default(cuid())
  schoolId  String
  school    School       @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  examTabId String
  examTab   ScoreExamTab @relation(fields: [examTabId], references: [id], onDelete: Cascade)
  subjectId String
  subject   ScoreSubject @relation(fields: [subjectId], references: [id], onDelete: Cascade)
