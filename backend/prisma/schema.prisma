// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Multi-tenancy root ───────────────────────────────────────────────────────
// One row per customer school. Every tenant-scoped model below carries a direct
// `schoolId` FK (not just a transitive one via a parent relation) so the backend
// Prisma Client Extension (see backend/src/database/prisma.service.ts, Phase 2 of
// the conversion plan) can uniformly auto-inject a `schoolId` filter on every
// query without needing model-specific logic.
//
// A reserved sentinel row (subdomain = "platform", see
// backend/src/tenancy/constants.ts) exists so PLATFORM_ADMIN users — who don't
// belong to any real school — still have a non-null schoolId. This keeps the
// column NOT NULL everywhere, which simplifies the auto-scoping extension (no
// per-model null-handling) at the cost of one fake row that Platform-tier School
// listings must filter out.
model School {
  id            String   @id @default(cuid())
  subdomain     String   @unique // matches <subdomain>.wattaman.app; "platform" is the reserved sentinel
  customDomain  String?  @unique // optional, e.g. "portal.someschool.com" — layered on top of subdomain, never a
  // replacement for it (see the conversion plan's custom-domain discussion). Globally unique is correct
  // here, unlike almost everything else in this schema — domain ownership is inherently public, not a
  // cross-tenant leak vector.
  name          String
  status        String   @default("PROVISIONING") // PROVISIONING | ACTIVE | SUSPENDED | DELETION_SCHEDULED | DELETED
  storagePrefix String   @unique
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  users                     User[]
  refreshTokens             RefreshToken[]
  passwordResetTokens       PasswordResetToken[]
  auditLogs                 AuditLog[]
  auditCleanupSchedules     AuditCleanupSchedule[]
  schoolDailyMetrics        SchoolDailyMetric[]
  siteSetting               SiteSetting?
  posts                     Post[]
  extensionInstallations    ExtensionInstallation[]
  extensionRecords          ExtensionRecord[]
  extensionVisibilityGrants ExtensionVisibilityGrant[]
  extensionPilotFeedback    ExtensionPilotFeedback[]
  domains                   SchoolDomain[]
  provisioningJobs          SchoolProvisioningJob[]
}

model SchoolProvisioningJob {
  id          String    @id @default(cuid())
  schoolId    String
  school      School    @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  requestKey  String    @unique
  status      String    @default("PENDING") // PENDING | RUNNING | COMPLETED | FAILED
  attempts    Int       @default(0)
  lastError   String?
  startedAt   DateTime?
  completedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([schoolId, status])
}

model SchoolDomain {
  id                String    @id @default(cuid())
  schoolId          String
  school            School    @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  hostname          String    @unique
  type              String    @default("MANAGED") // MANAGED | CUSTOM | PLATFORM | LEGACY_ALIAS
  status            String    @default("VERIFIED") // PENDING | VERIFIED | FAILED | DISABLED
  verificationToken String?   @unique
  verifiedAt        DateTime?
  lastCheckedAt     DateTime?
  verificationError String?
  routingStatus     String    @default("PENDING") // PENDING | READY | FAILED
  routingCheckedAt  DateTime?
  routingError      String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@index([schoolId, status])
}

model User {
  id              String   @id @default(cuid())
  schoolId        String
  school          School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  email           String? // nullable — a user may register with phone instead. Unique per-school, not globally (see @@unique below).
  password        String
  name            String
  phone           String?
  phoneNormalized String? // digits-only form of `phone`, used as an alternate login identifier when no email is set. Unique per-school.
  photo           String?
  role            String
  mfaSecret       String? // TOTP secret, base32 — set on /auth/mfa/setup, not yet trusted until mfaEnabled
  mfaEnabled      Boolean  @default(false) // PLATFORM_ADMIN login requires this to be true once set up (Phase 2a)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  refreshTokens                 RefreshToken[]
  passwordResetTokens           PasswordResetToken[]
  extensionPublisherMemberships ExtensionPublisherMember[]

  @@unique([schoolId, email])
  @@unique([schoolId, phoneNormalized])
  @@index([schoolId])
}

model RefreshToken {
  id        String   @id @default(cuid())
  // Not part of a uniqueness leak-vector concern (see the conversion plan's guiding
  // security principle) — `token` is a random opaque value, not a human-chosen
  // identifier, so it stays globally @unique. schoolId is carried for consistency
  // with every other tenant-scoped model, not for uniqueness enforcement.
  schoolId  String
  school    School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  token     String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([schoolId])
  @@index([userId])
  @@index([expiresAt])
}

// Single-use, short-lived token for the /auth/forgot-password → /auth/reset-password
// flow (Phase 2a). Deliberately a separate model from RefreshToken — different
// semantics (single-use, short TTL, one specific purpose) rather than overloading
// a session-token model with password-recovery meaning.
model PasswordResetToken {
  id        String    @id @default(cuid())
  schoolId  String
  school    School    @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  token     String    @unique
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([schoolId])
  @@index([userId])
  @@index([expiresAt])
}

/// Stable platform-global identity for an installable extension.
model Extension {
  id               String             @id @default(cuid())
  key              String             @unique
  name             String
  description      String?
  runtimeType      String // CORE_MODULE | DECLARATIVE_MODULE | THEME | INTEGRATION | CODE_EXTENSION
  commercialType   String // MODULE | ADDON | THEME
  price            Float?
  priceNote        String?
  pricingModel     String             @default("FREE") // FREE | ONE_TIME | SUBSCRIPTION | PRIVATE_CONTRACT
  priceMinor       Int?
  currency         String             @default("USD")
  billingInterval  String? // MONTHLY | YEARLY
  contractReference String?
  category         String             @default("OTHER")
  tags             String[]           @default([])
  locales          String[]           @default(["en"])
  supportUrl       String?
  privacyPolicyUrl String?
  dataUse          Json               @default("{\"collectsPersonalData\":false,\"dataCategories\":[],\"purposes\":[],\"sharesWithThirdParties\":false,\"retentionDays\":null}")
  featuredRank     Int                @default(1000000)
  publisher        String             @default("WATTAMAN")
  publisherId      String
  publisherEntity  ExtensionPublisher @relation(fields: [publisherId], references: [id], onDelete: Restrict)
  status           String             @default("ACTIVE") // ACTIVE | SUSPENDED | RETIRED
  isListed         Boolean            @default(false)
  visibility       String             @default("UNLISTED") // LISTED | UNLISTED | PRIVATE
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt

  versions         ExtensionVersion[]
  installations    ExtensionInstallation[]
  records          ExtensionRecord[]
  visibilityGrants ExtensionVisibilityGrant[]
  dependencies     ExtensionDependency[]            @relation("ExtensionDependencies")
  requiredBy       ExtensionDependency[]            @relation("RequiredExtensionDependencies")
  collectionItems  ExtensionCatalogCollectionItem[]

  @@index([runtimeType, status])
  @@index([commercialType, isListed])
  @@index([category, status])
  @@index([featuredRank, createdAt])
  @@index([visibility, status])
  @@index([publisherId, status])
}

model ExtensionCatalogCollection {
  id          String   @id @default(cuid())
  slug        String   @unique
  title       String
  description String?
  locale      String   @default("en")
  status      String   @default("DRAFT") // DRAFT | PUBLISHED | ARCHIVED
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  items ExtensionCatalogCollectionItem[]

  @@index([status, sortOrder])
}

model ExtensionCatalogCollectionItem {
  id           String                     @id @default(cuid())
  collectionId String
  collection   ExtensionCatalogCollection @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  extensionId  String
  extension    Extension                  @relation(fields: [extensionId], references: [id], onDelete: Cascade)
  position     Int                        @default(0)
  createdAt    DateTime                   @default(now())

  @@unique([collectionId, extensionId])
  @@index([collectionId, position])
  @@index([extensionId])
}

model ExtensionVisibilityGrant {
  id          String    @id @default(cuid())
  extensionId String
  extension   Extension @relation(fields: [extensionId], references: [id], onDelete: Cascade)
  schoolId    String
  school      School    @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  grantedBy   String?
  createdAt   DateTime  @default(now())

  @@unique([extensionId, schoolId])
  @@index([schoolId, createdAt])
}

model ExtensionPublisher {
  id                 String    @id @default(cuid())
  key                String    @unique
  name               String
  legalName          String?
  websiteUrl         String?
  countryCode        String?
  status             String    @default("ACTIVE") // ACTIVE | SUSPENDED | REVOKED
  verificationStatus String    @default("PENDING") // PENDING | VERIFIED | REJECTED
  verificationNotes  String?
  verifiedAt         DateTime?
  verifiedBy         String?
  internal           Boolean   @default(true)
  contactEmail       String?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  extensions  Extension[]
  members     ExtensionPublisherMember[]
  signingKeys ExtensionSigningKey[]

  @@index([status, internal])
  @@index([verificationStatus, createdAt])
}

model ExtensionSigningKey {
  id           String             @id @default(cuid())
  publisherId  String
  publisher    ExtensionPublisher @relation(fields: [publisherId], references: [id], onDelete: Cascade)
  keyId        String             @unique
  algorithm    String             @default("Ed25519")
  publicKeyPem String
  status       String             @default("ACTIVE") // ACTIVE | RETIRED | REVOKED
  createdAt    DateTime           @default(now())
  retiredAt    DateTime?
  revokedAt    DateTime?

  versions ExtensionVersion[]

  @@index([publisherId, status])
}

model ExtensionPublisherMember {
  id          String             @id @default(cuid())
  publisherId String
  publisher   ExtensionPublisher @relation(fields: [publisherId], references: [id], onDelete: Cascade)
  userId      String
  user        User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  roles       Json
  status      String             @default("ACTIVE") // ACTIVE | SUSPENDED
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt

  @@unique([publisherId, userId])
  @@index([userId, status])
}

/// Immutable release metadata. Published rows must never be updated in-place;
/// lifecycle services enforce that rule and create a new semantic version.
model ExtensionVersion {
  id                 String               @id @default(cuid())
  extensionId        String
  extension          Extension            @relation(fields: [extensionId], references: [id], onDelete: Cascade)
  version            String
  manifestSchema     Int                  @default(1)
  manifest           Json
  packageStorageKey  String?
  packageChecksum    String?
  packageSize        Int?
  compatibilityRange String?
  lifecycleStatus    String               @default("UPLOADED") // UPLOADED | QUARANTINED | VALIDATING | VALIDATED | REJECTED | AWAITING_REVIEW | APPROVED | PUBLISHED | DEPRECATED | BLOCKED | RETIRED
  reviewNotes        String?
  releaseNotes       String?
  uploadedBy         String?
  reviewedBy         String?
  publishedAt        DateTime?
  signingKeyId       String?
  signingKey         ExtensionSigningKey? @relation(fields: [signingKeyId], references: [id], onDelete: Restrict)
  packageSignature   String?
  signedAt           DateTime?
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt

  assets        ExtensionAsset[]
  permissions   ExtensionPermission[]
  validations   ExtensionValidation[]
  installations ExtensionInstallation[]
  reviews       ExtensionReview[]

  @@unique([extensionId, version])
  @@index([extensionId, lifecycleStatus])
  @@index([lifecycleStatus, createdAt])
  @@index([packageChecksum])
  @@index([signingKeyId])
}

model ExtensionReview {
  id                 String           @id @default(cuid())
  extensionVersionId String
  extensionVersion   ExtensionVersion @relation(fields: [extensionVersionId], references: [id], onDelete: Cascade)
  action             String // SUBMITTED | APPROVED | REJECTED | APPEALED
  notes              String?
  assessment         Json?
  actorId            String?
  actorRole          String?
  createdAt          DateTime         @default(now())

  @@index([extensionVersionId, createdAt])
  @@index([action, createdAt])
}

model ExtensionAlert {
  id             String    @id @default(cuid())
  fingerprint    String    @unique
  type           String // VALIDATION_FAILURE | CAPABILITY_DENIED
  severity       String // WARNING | CRITICAL
  status         String    @default("OPEN") // OPEN | ACKNOWLEDGED | RESOLVED
  extensionId    String?
  versionId      String?
  schoolId       String    @default("PLATFORM")
  message        String
  occurrences    Int       @default(1)
  details        Json?
  firstSeenAt    DateTime  @default(now())
  lastSeenAt     DateTime  @default(now())
  acknowledgedBy String?
  acknowledgedAt DateTime?
  resolvedBy     String?
  resolvedAt     DateTime?

  @@index([status, severity, lastSeenAt])
  @@index([extensionId, lastSeenAt])
}

model ExtensionApiMetric {
  id              String   @id @default(cuid())
  bucket          DateTime
  route           String
  method          String
  statusClass     String
  schoolId        String?
  requestCount    Int      @default(0)
  errorCount      Int      @default(0)
  totalDurationMs Int      @default(0)
  maxDurationMs   Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([bucket, route, method, statusClass, schoolId])
  @@index([bucket, route])
  @@index([schoolId, bucket])
}

model ExtensionAsset {
  id                 String           @id @default(cuid())
  extensionVersionId String
  extensionVersion   ExtensionVersion @relation(fields: [extensionVersionId], references: [id], onDelete: Cascade)
  path               String
  storageKey         String
  checksum           String
  mimeType           String
  size               Int
  createdAt          DateTime         @default(now())

  @@unique([extensionVersionId, path])
  @@index([extensionVersionId])
}

model ExtensionPermission {
  id                 String           @id @default(cuid())
  extensionVersionId String
  extensionVersion   ExtensionVersion @relation(fields: [extensionVersionId], references: [id], onDelete: Cascade)
  capability         String
  description        String?
  sensitive          Boolean          @default(false)
  createdAt          DateTime         @default(now())

  @@unique([extensionVersionId, capability])
  @@index([capability])
}

model ExtensionDependency {
  id                  String    @id @default(cuid())
  extensionId         String
  extension           Extension @relation("ExtensionDependencies", fields: [extensionId], references: [id], onDelete: Cascade)
  requiredExtensionId String
  requiredExtension   Extension @relation("RequiredExtensionDependencies", fields: [requiredExtensionId], references: [id], onDelete: Restrict)
  versionRange        String?
  optional            Boolean   @default(false)
  createdAt           DateTime  @default(now())

  @@unique([extensionId, requiredExtensionId])
  @@index([requiredExtensionId])
}

model ExtensionValidation {
  id                 String           @id @default(cuid())
  extensionVersionId String
  extensionVersion   ExtensionVersion @relation(fields: [extensionVersionId], references: [id], onDelete: Cascade)
  status             String // RUNNING | PASSED | FAILED | TIMED_OUT
  errors             Json?
  warnings           Json?
  validatorVersion   String?
  toolVersions       Json?
  reportSchema       Int              @default(1)
  startedAt          DateTime         @default(now())
  completedAt        DateTime?

  @@index([extensionVersionId, startedAt])
  @@index([status, startedAt])
}

/// Tenant-owned installation state. This model is included in
/// TENANT_SCOPED_MODELS so every normal request is automatically school-bound.
model ExtensionInstallation {
  id                 String                   @id @default(cuid())
  schoolId           String
  school             School                   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  extensionId        String
  extension          Extension                @relation(fields: [extensionId], references: [id], onDelete: Restrict)
  installedVersionId String
  installedVersion   ExtensionVersion         @relation(fields: [installedVersionId], references: [id], onDelete: Restrict)
  enabled            Boolean                  @default(false)
  lifecycleState     String                   @default("REQUESTED") // REQUESTED | PAYMENT_REVIEW | APPROVED | INSTALLED | ACTIVE | UNINSTALLED
  configuration      Json?
  billingStatus      String                   @default("PENDING")
  requestSchoolName  String?
  requestAdminName   String?
  requestAdminEmail  String?
  paymentReference   String?
  paymentNotes       String?
  invoiceStorageKey  String?
  invoiceFileName    String?
  invoiceContentType String?
  invoiceSize        Int?
  invoiceChecksum    String?
  invoiceUploadedAt  DateTime?
  paymentSubmittedAt DateTime?
  requestPricingModel String?
  requestPriceMinor   Int?
  requestCurrency     String?
  requestBillingInterval String?
  requestContractReference String?
  requestPriceNote    String?
  dataBytes          Int                      @default(0)
  updatePolicy       String                   @default("MANUAL") // MANUAL | NOTIFY | AUTO_APPROVED
  availableVersionId String?
  updateNotifiedAt   DateTime?
  requestedBy        String?
  requestedAt        DateTime?
  approvedBy         String?
  approvedAt         DateTime?
  installedBy        String?
  installedAt        DateTime?
  uninstalledAt      DateTime?
  purgeAfter         DateTime?
  createdAt          DateTime                 @default(now())
  updatedAt          DateTime                 @updatedAt
  migrationRuns      ExtensionMigrationRun[]
  pilotFeedback      ExtensionPilotFeedback[]

  @@unique([schoolId, extensionId])
  @@index([schoolId, enabled])
  @@index([schoolId, lifecycleState, updatedAt])
  @@index([extensionId, installedVersionId])
  @@index([purgeAfter])
  @@index([updatePolicy, availableVersionId])
}

model ExtensionPaymentSetting {
  id            String   @id @default("default")
  bankName      String?
  accountName   String?
  accountNumber String?
  currency      String   @default("USD")
  instructions  String?
  qrStorageKey  String?
  qrContentType String?
  qrFileName    String?
  version       Int      @default(0)
  updatedBy     String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  history       ExtensionPaymentSettingHistory[]
}

model ExtensionPaymentSettingHistory {
  id            String                  @id @default(cuid())
  settingId     String                  @default("default")
  setting       ExtensionPaymentSetting @relation(fields: [settingId], references: [id], onDelete: Cascade)
  version       Int
  bankName      String?
  accountName   String?
  accountNumber String?
  currency      String
  instructions  String?
  qrStorageKey  String?
  qrContentType String?
  qrFileName    String?
  actorId       String?
  createdAt     DateTime                @default(now())

  @@unique([settingId, version])
  @@index([settingId, createdAt])
}

model ExtensionPilotFeedback {
  id             String                @id @default(cuid())
  installationId String
  installation   ExtensionInstallation @relation(fields: [installationId], references: [id], onDelete: Cascade)
  schoolId       String
  school         School                @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  source         String // SCHOOL_ADMIN | OPERATOR
  outcome        String // ACCEPTED | NEEDS_WORK | BLOCKED
  rating         Int
  checklist      Json
  comments       String?
  actorId        String?
  actorRole      String?
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt

  @@unique([installationId, source])
  @@index([schoolId, createdAt])
  @@index([outcome, updatedAt])
}

model ExtensionMigrationRun {
  id             String                     @id @default(cuid())
  installationId String
  installation   ExtensionInstallation      @relation(fields: [installationId], references: [id], onDelete: Cascade)
  schoolId       String
  extensionId    String
  fromVersionId  String
  toVersionId    String
  status         String                     @default("APPLIED") // APPLIED | ROLLED_BACK
  operations     Json
  createdAt      DateTime                   @default(now())
  rolledBackAt   DateTime?
  backups        ExtensionMigrationBackup[]

  @@index([installationId, createdAt])
  @@index([schoolId, extensionId, status])
}

model ExtensionMigrationBackup {
  id             String                @id @default(cuid())
  migrationRunId String
  migrationRun   ExtensionMigrationRun @relation(fields: [migrationRunId], references: [id], onDelete: Cascade)
  recordId       String
  resource       String
  data           Json
  byteSize       Int
  createdAt      DateTime              @default(now())

  @@unique([migrationRunId, recordId])
  @@index([recordId])
}

/// Generic tenant-scoped records for declarative modules. The platform owns
/// storage and validation; packages only declare resource schemas.
model ExtensionRecord {
  id          String    @id @default(cuid())
  schoolId    String
  school      School    @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  extensionId String
  extension   Extension @relation(fields: [extensionId], references: [id], onDelete: Cascade)
  resource    String
  data        Json
  byteSize    Int       @default(0)
  createdBy   String?
  updatedBy   String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([schoolId, extensionId, resource, createdAt])
  @@index([extensionId, resource])
  @@index([schoolId, byteSize])
}

/// Append-only audit trail of every privileged action in the system.
/// Designed for compliance + forensics: actor identity is denormalized so
/// the record survives even if the user is later deleted.
model AuditLog {
  id        String   @id @default(cuid())
  schoolId  String // Every request already resolves a school before auth runs (Phase 2's
  // TenantHostMiddleware), including PLATFORM_ADMIN traffic on the reserved platform
  // host (resolves to the sentinel School) — so this is never null in practice.
  school    School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  // ── Who ──
  actorId    String? // null for anonymous / system events (e.g. failed login attempt)
  actorRole  String?
  actorName  String? // denormalized snapshot
  actorEmail String? // denormalized snapshot

  // ── What ──
  // High-level verb. Suggested set: CREATE, READ, UPDATE, DELETE, LOGIN,
  // LOGIN_FAILED, LOGOUT, EXPORT, IMPORT, ROLE_CHANGE, PASSWORD_RESET,
  // PERMISSION_CHANGE, BACKUP, RESTORE, IMPERSONATION_START, IMPERSONATION_END.
  action        String
  // Resource type, e.g. USER, STUDENT, CLASS, ATTENDANCE, CARD_TEMPLATE,
  // EXAM, FEE, SALARY, ANNOUNCEMENT, BACKUP, SETTINGS, SCHOOL, etc.
  resource      String
  resourceId    String?
  resourceLabel String? // human-readable snapshot (e.g. student name)

  // ── Detail ──
  changes  Json? // { before: {...}, after: {...} } or array of diffs
  metadata Json? // arbitrary structured context

  // ── Request context ──
  method     String? // HTTP method
  path       String? // request path
  statusCode Int?
  ip         String?
  userAgent  String?

  // ── Outcome ──
  success      Boolean @default(true)
  errorMessage String?

  @@index([schoolId, createdAt])
  @@index([createdAt])
  @@index([actorId, createdAt])
  @@index([resource, resourceId, createdAt])
  @@index([action, createdAt])
}

/// Stores admin-configured schedules for automatic audit log cleanup. Per-school —
/// each school's admin sets their own retention policy.
model AuditCleanupSchedule {
  id        String   @id @default(cuid())
  schoolId  String
  school    School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// Human-readable label, e.g. "Daily – keep 90 days"
  label String

  /// How often to run: HOURLY | DAILY | WEEKLY | MONTHLY
  frequency String

  /// Number of days of logs to retain (older entries are deleted)
  retainDays Int

  /// Whether this schedule is active
  enabled Boolean @default(true)

  /// ISO timestamp of the last successful run (null = never ran)
  lastRunAt DateTime?

  /// Number of rows deleted in the last run
  lastDeletedCount Int @default(0)

  @@index([schoolId])
  @@index([enabled])
}

/// Daily rollup of a school's activity/latency, one row per school per
/// finalized (past) day. Populated by a nightly cron (SchoolMetricsService),
/// not read from AuditLog live — this decouples usage history from each
/// school's own AuditCleanupSchedule retention, which can be as short as a
/// few days and hard-deletes old AuditLog rows.
model SchoolDailyMetric {
  id       String   @id @default(cuid())
  schoolId String
  school   School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  date     DateTime // UTC midnight — the day this row summarizes

  /// Count of tracked (mutating) AuditLog events that day.
  requestCount    Int    @default(0)
  /// Of those, how many had success: false.
  errorCount      Int    @default(0)
  avgDurationMs   Float?
  p95DurationMs   Float?
  /// Distinct actorId count that day.
  activeUserCount Int    @default(0)
  /// Snapshot (not a daily delta) of total bytes stored across all base64 image/logo/design
  /// columns for this school, as of computedAt — see SchoolMetricsService for the exact column list.
  storageBytes    BigInt @default(0)

  computedAt DateTime @default(now())

  @@unique([schoolId, date])
  @@index([date])
}

model SiteSetting {
  id               String   @id @default(cuid())
  schoolId         String   @unique
  school           School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  // Header
  siteName         String   @default("Wattaman")
  siteTagline      String   @default("Smart School Management")
  logoUrl          String   @default("")
  // Hero banner slides — JSON array of { id, imageUrl, title, subtitle, ctaLabel, ctaHref }
  heroSlides       String   @default("[]")
  // Footer
  footerAddress    String   @default("")
  footerPhone      String   @default("")
  footerEmail      String   @default("")
  footerFacebook   String   @default("")
  footerInstagram  String   @default("")
  footerTwitter    String   @default("")
  footerYoutube    String   @default("")
  footerCopyright  String   @default("")
  // Theme (Phase 19 — secondaryColor/font/radius joined the pre-existing
  // primaryColor once a theme became a 5-knob preset instead of just a color;
  // font/radius stay plain strings, validated against the frontend's own
  // curated lists at the UI layer only, matching primaryColor's own existing
  // convention of no server-side validation on this school-owned endpoint.
  // mode joined later, once app/page.tsx got real dark: support of its own —
  // school-wide (this record), not personal like the dashboard's own
  // light/dark toggle in localStorage)
  mode             String   @default("light")
  primaryColor     String   @default("#4f46e5")
  secondaryColor   String   @default("#0284c7")
  font             String   @default("inter")
  radius           String   @default("soft")
  // Custom CSS
  customCss        String   @default("")
  // About section
  aboutBadge       String   @default("About Us")
  aboutTitle       String   @default("A Smarter Way to Manage Your School")
  aboutDescription String   @default("")
  aboutImageUrl    String   @default("")
  aboutFeatures    String   @default("[]") // JSON string[]
  aboutCtaLabel    String   @default("Get Started Today")
  aboutCtaHref     String   @default("/login")
  updatedAt        DateTime @updatedAt
}

model Post {
  id        String   @id @default(cuid())
  schoolId  String
  school    School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  title     String
  excerpt   String   @default("")
  body      String   @default("")
  // 'text' | 'image' | 'video'
  type      String   @default("text")
  imageUrl  String   @default("")
  videoUrl  String   @default("")
  published Boolean  @default(false)
  pinned    Boolean  @default(false)
  tags      String   @default("[]") // JSON array of strings
  authorId  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([schoolId])
}
