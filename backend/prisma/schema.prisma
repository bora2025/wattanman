// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Multi-tenancy root ───────────────────────────────────────────────────────
// One row per customer school. Every tenant-scoped model below carries a direct
// `schoolId` FK (not just a transitive one via a parent relation) so the backend
// Prisma Client Extension (see backend/src/database/prisma.service.ts, Phase 2 of
// the conversion plan) can uniformly auto-inject a `schoolId` filter on every
// query without needing model-specific logic.
//
// A reserved sentinel row (subdomain = "platform", see
// backend/src/tenancy/constants.ts) exists so PLATFORM_ADMIN users — who don't
// belong to any real school — still have a non-null schoolId. This keeps the
// column NOT NULL everywhere, which simplifies the auto-scoping extension (no
// per-model null-handling) at the cost of one fake row that Platform-tier School
// listings must filter out.
model School {
  id           String   @id @default(cuid())
  subdomain    String   @unique // matches <subdomain>.wattaman.app; "platform" is the reserved sentinel
  customDomain String?  @unique // optional, e.g. "portal.someschool.com" — layered on top of subdomain, never a
  // replacement for it (see the conversion plan's custom-domain discussion). Globally unique is correct
  // here, unlike almost everything else in this schema — domain ownership is inherently public, not a
  // cross-tenant leak vector.
  name         String
  status       String   @default("ACTIVE") // ACTIVE | SUSPENDED | TRIAL
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // ── Relations (one array/optional field per tenant-scoped model) ──
  users                       User[]
  classes                     Class[]
  students                    Student[]
  cardAliases                 CardAlias[]
  attendances                 Attendance[]
  notifications               Notification[]
  parentLinkRequests          ParentLinkRequest[]
  classRegistrations          ClassRegistration[]
  classRegistrationSettings   ClassRegistrationSettings?
  classRegistrationFields     ClassRegistrationField[]
  staffAttendances            StaffAttendance[]
  sessionConfigs              SessionConfig[]
  staffWeeklySchedule         StaffWeeklySchedule?
  studyYears                  StudyYear[]
  holidays                    Holiday[]
  departments                 Department[]
  refreshTokens               RefreshToken[]
  passwordResetTokens         PasswordResetToken[]
  auditLogs                   AuditLog[]
  auditCleanupSchedules       AuditCleanupSchedule[]
  schoolDailyMetrics          SchoolDailyMetric[]
  cardTemplates               CardTemplate[]
  attendanceFormatRules       AttendanceFormatRule[]
  feeRecords                  FeeRecord[]
  feePayments                 FeePayment[]
  timetables                  Timetable[]
  timetableSubjects           TimetableSubject[]
  timetableClasses            TimetableClass[]
  timetableClassrooms         TimetableClassroom[]
  timetableTeachers           TimetableTeacher[]
  timetableLessons            TimetableLesson[]
  timetableEntries            TimetableEntry[]
  timetableTeacherAttendances TimetableTeacherAttendance[]
  scoreSheets                 ScoreSheet[]
  scoreSheetClasses           ScoreSheetClass[]
  scoreSubjects               ScoreSubject[]
  scoreExamTabs               ScoreExamTab[]
  scoreEntries                ScoreEntry[]
  salaries                    Salary[]
  staffProfiles               StaffProfile[]
  staffEducations             StaffEducation[]
  staffWorkExperiences        StaffWorkExperience[]
  staffCertifications         StaffCertification[]
  buses                       Bus[]
  busRoutes                   BusRoute[]
  busStops                    BusStop[]
  busLocations                BusLocation[]
  exams                       Exam[]
  examQuestions               ExamQuestion[]
  examAttempts                ExamAttempt[]
  assignments                 Assignment[]
  assignmentSubmissions       AssignmentSubmission[]
  quizQuestions               QuizQuestion[]
  quizAnswers                 QuizAnswer[]
  messages                    Message[]
  announcements               Announcement[]
  announcementReads           AnnouncementRead[]
  notificationPreferences     NotificationPreference[]
  courses                     Course[]
  courseLessons               CourseLesson[]
  lessonPages                 LessonPage[]
  courseEnrollments           CourseEnrollment[]
  lessonAttempts              LessonAttempt[]
  pageResponses               PageResponse[]
  courseSessions              CourseSession[]
  courseAttendances           CourseAttendance[]
  lessonViews                 LessonView[]
  feeSettings                 FeeSettings?
  siteSetting                 SiteSetting?
  posts                       Post[]
  schoolAddons                SchoolAddon[]
  extensionInstallations      ExtensionInstallation[]
  extensionRecords            ExtensionRecord[]
}

model User {
  id              String      @id @default(cuid())
  schoolId        String
  school          School      @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  email           String? // nullable — a user may register with phone instead. Unique per-school, not globally (see @@unique below).
  password        String
  name            String
  phone           String?
  phoneNormalized String? // digits-only form of `phone`, used as an alternate login identifier when no email is set. Unique per-school.
  photo           String?
  role            String
  mfaSecret       String? // TOTP secret, base32 — set on /auth/mfa/setup, not yet trusted until mfaEnabled
  mfaEnabled      Boolean     @default(false) // PLATFORM_ADMIN login requires this to be true once set up (Phase 2a)
  departmentId    String?
  department      Department? @relation(fields: [departmentId], references: [id])
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  // Relations
  classesAsTeacher    Class[]           @relation("TeacherClasses")
  classesAsClassAdmin Class[]           @relation("ClassAdminClasses")
  attendancesMarked   Attendance[]      @relation("MarkedBy")
  notifications       Notification[]
  staffAttendances    StaffAttendance[] @relation("StaffAttendances")
  staffMarkedBy       StaffAttendance[] @relation("StaffMarkedBy")

  // For students and parents
  studentProfile                Student?
  parentStudents                Student[]                  @relation("ParentStudents")
  refreshTokens                 RefreshToken[]
  passwordResetTokens           PasswordResetToken[]
  extensionPublisherMemberships ExtensionPublisherMember[]

  // Module 1: Salary
  salaries Salary[] @relation("UserSalaries")

  // Staff Curriculum Vitae
  staffProfile        StaffProfile?
  staffEducation      StaffEducation[]
  staffWorkExperience StaffWorkExperience[]
  staffCertifications StaffCertification[]

  // Module 3: Exams
  examsCreated Exam[] @relation("ExamCreator")

  // Modules 5 & 6: Assignments
  assignmentsCreated Assignment[] @relation("AssignmentCreator")

  // Courses (LMS): authored by teachers / admins
  coursesCreated          Course[]           @relation("CourseCreator")
  courseAttendancesMarked CourseAttendance[] @relation("CourseAttendanceMarkedBy")

  // Module 4: Messages
  messagesSent     Message[] @relation("MessageSender")
  messagesReceived Message[] @relation("MessageReceiver")

  // Announcements (Phase 1: Communication Hub)
  announcementsAuthored  Announcement[]          @relation("AnnouncementAuthor")
  announcementReads      AnnouncementRead[]      @relation("AnnouncementReads")
  notificationPreference NotificationPreference?

  @@unique([schoolId, email])
  @@unique([schoolId, phoneNormalized])
  @@index([schoolId])
}

model Class {
  id                 String     @id @default(cuid())
  schoolId           String
  school             School     @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  name               String
  subject            String?
  teacherId          String?
  teacher            User?      @relation("TeacherClasses", fields: [teacherId], references: [id])
  classAdminId       String?
  classAdmin         User?      @relation("ClassAdminClasses", fields: [classAdminId], references: [id])
  studyYearId        String?
  studyYear          StudyYear? @relation(fields: [studyYearId], references: [id])
  schedule           String? // e.g., "Mon 9:00-10:00"
  // Public student self-registration visibility: AVAILABLE | UNAVAILABLE | HIDDEN
  registrationStatus String     @default("HIDDEN")
  // Public marketing card fields (shown on the home page registration listing)
  thumbnail          String? // base64 data URL or external URL
  description        String?
  price              Float?
  showPrice          Boolean    @default(false)
  createdAt          DateTime   @default(now())
  updatedAt          DateTime   @updatedAt

  // Relations
  students       Student[]
  attendances    Attendance[]
  sessionConfigs SessionConfig[]
  exams          Exam[]              @relation("ClassExams")
  assignments    Assignment[]        @relation("ClassAssignments")
  announcements  Announcement[]      @relation("ClassAnnouncements")
  courses        Course[]            @relation("ClassCourses")
  registrations  ClassRegistration[]

  @@index([schoolId])
}

model Student {
  id                String    @id @default(cuid())
  schoolId          String
  school            School    @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  studentNumber     String? // ID number from CSV (e.g., 0001, 0002)
  userId            String    @unique
  user              User      @relation(fields: [userId], references: [id])
  classId           String?
  class             Class?    @relation(fields: [classId], references: [id])
  parentId          String?
  parent            User?     @relation("ParentStudents", fields: [parentId], references: [id])
  qrCode            String? // For static QR if needed. Unique per-school — see @@unique below.
  photo             String? // URL or base64 of student photo
  sex               String? // MALE or FEMALE
  dateOfBirth       DateTime? // Date of birth
  address           String? // Home address
  generation        String? // Nth generation (ជំនាន់)
  nameKh            String? // Khmer name — captured at self-registration; User.name stays the English name used for display
  customFieldValues Json? // { [ClassRegistrationField.key]: string } — copied over from ClassRegistration on approval
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  // Relations
  attendances           Attendance[]
  feeRecords            FeeRecord[]
  examAttempts          ExamAttempt[]          @relation("StudentExamAttempts")
  assignmentSubmissions AssignmentSubmission[] @relation("StudentSubmissions")
  parentLinkRequests    ParentLinkRequest[]
  cardAliases           CardAlias[]
  courseEnrollments     CourseEnrollment[]     @relation("StudentCourseEnrollments")
  courseAttendances     CourseAttendance[]     @relation("StudentCourseAttendances")
  lessonViews           LessonView[]           @relation("StudentLessonViews")

  @@unique([schoolId, qrCode])
  @@index([schoolId])
  @@index([studentNumber])
  @@index([classId])
  @@index([parentId])
}

// Maps an arbitrary QR payload (e.g. an old cuid printed on a physical card)
// to the current Student. Lets pre-printed cards keep working after a CSV
// re-import regenerates Student.id values.
model CardAlias {
  id          String   @id @default(cuid())
  schoolId    String
  school      School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  qrValue     String // Unique per-school — see @@unique below. Scan-resolution (AttendanceService.wattamanScan)
  // always runs under an authenticated, already school-scoped WATTAMAN user, so a per-school
  // unique constraint is safe and avoids any cross-school collision risk.
  studentId   String
  student     Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  createdById String?
  createdAt   DateTime @default(now())

  @@unique([schoolId, qrValue])
  @@index([schoolId])
  @@index([studentId])
}

model Attendance {
  id                  String    @id @default(cuid())
  schoolId            String
  school              School    @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  studentId           String
  student             Student   @relation(fields: [studentId], references: [id])
  classId             String
  class               Class     @relation(fields: [classId], references: [id])
  date                DateTime
  session             Int       @default(1) // 1=Morning1, 2=Morning2, 3=Afternoon1, 4=Afternoon2
  status              String
  permissionType      String?
  permissionStartDate DateTime?
  permissionEndDate   DateTime?
  checkInTime         DateTime?
  checkOutTime        DateTime?
  markedById          String
  markedBy            User      @relation("MarkedBy", fields: [markedById], references: [id])
  scanLatitude        Float? // GPS latitude at scan time
  scanLongitude       Float? // GPS longitude at scan time
  scanLocation        String? // Human-readable location label
  timestamp           DateTime  @default(now())

  @@unique([schoolId, studentId, classId, date, session])
  @@index([schoolId])
  @@index([date])
  @@index([classId, date])
  @@index([studentId, date])
  @@index([status])
  @@index([markedById])
}

model Notification {
  id       String    @id @default(cuid())
  schoolId String
  school   School    @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  userId   String
  user     User      @relation(fields: [userId], references: [id])
  message  String
  type     String // e.g., "absence", "late"
  sentAt   DateTime  @default(now())
  readAt   DateTime?

  @@index([schoolId])
  @@index([userId, sentAt])
  @@index([sentAt])
  @@index([readAt])
}

// Student-initiated request to be linked to a parent account. Reviewed by admin.
model ParentLinkRequest {
  id           String    @id @default(cuid())
  schoolId     String
  school       School    @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  studentId    String
  student      Student   @relation(fields: [studentId], references: [id])
  parentEmail  String
  parentName   String?
  parentPhone  String?
  note         String?
  status       String    @default("PENDING") // PENDING | APPROVED | REJECTED
  rejectReason String?
  createdAt    DateTime  @default(now())
  resolvedAt   DateTime?
  resolvedBy   String? // admin user id

  @@index([schoolId])
  @@index([status])
  @@index([studentId])
}

// Public, unauthenticated student self-registration request for a class.
// Reviewed by admin; approval creates the User + Student records.
model ClassRegistration {
  id                String    @id @default(cuid())
  schoolId          String
  school            School    @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  classId           String
  class             Class     @relation(fields: [classId], references: [id])
  nameKh            String? // required unless hidden/optional via ClassRegistrationSettings.khmerNameMode
  nameEn            String
  email             String? // at least one of email/phone is required — see createRegistration
  phone             String? // required unless hidden/optional via ClassRegistrationSettings.phoneMode
  passwordHash      String // bcrypt hash of the password the student chose, or an auto-generated one — see passwordMode
  generatedPassword String? // plaintext, set ONLY when auto-generated (never for a student-chosen password), so an admin can relay it
  photo             String? // base64 data URL, same convention as Student.photo
  sex               String? // MALE or FEMALE — required unless hidden/optional via ClassRegistrationSettings.sexMode
  dateOfBirth       DateTime? // required unless hidden/optional via ClassRegistrationSettings.dateOfBirthMode
  address           String? // required unless hidden/optional via ClassRegistrationSettings.addressMode
  generation        String? // required unless hidden/optional via ClassRegistrationSettings.generationMode
  customFieldValues Json? // { [ClassRegistrationField.key]: string }
  status            String    @default("PENDING") // PENDING | APPROVED | REJECTED
  rejectReason      String?
  studentId         String? // set once approved
  createdAt         DateTime  @default(now())
  resolvedAt        DateTime?
  resolvedBy        String? // admin user id

  @@index([schoolId])
  @@index([status])
  @@index([classId])
}

// Per-school toggle for which built-in fields the public registration form shows/requires.
// One row per school (schoolId unique) — was a single global "singleton" row pre-multi-tenancy.
model ClassRegistrationSettings {
  id              String   @id @default(cuid())
  schoolId        String   @unique
  school          School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  khmerNameMode   String   @default("REQUIRED") // REQUIRED | OPTIONAL | HIDDEN
  phoneMode       String   @default("REQUIRED") // REQUIRED | OPTIONAL | HIDDEN
  emailMode       String   @default("REQUIRED") // REQUIRED | OPTIONAL | HIDDEN — emailMode and phoneMode can't both be HIDDEN (no way to create a login otherwise)
  photoMode       String   @default("OPTIONAL") // REQUIRED | OPTIONAL | HIDDEN
  passwordMode    String   @default("REQUIRED") // REQUIRED | OPTIONAL | HIDDEN — non-REQUIRED means a password is auto-generated when the student doesn't set one
  sexMode         String   @default("HIDDEN") // REQUIRED | OPTIONAL | HIDDEN
  dateOfBirthMode String   @default("HIDDEN") // REQUIRED | OPTIONAL | HIDDEN
  addressMode     String   @default("HIDDEN") // REQUIRED | OPTIONAL | HIDDEN
  generationMode  String   @default("HIDDEN") // REQUIRED | OPTIONAL | HIDDEN
  updatedAt       DateTime @updatedAt
}

// Admin-defined extra fields rendered on the public registration form. Per-school
// (key is unique within a school, not globally) — a school's own custom-field slugs.
model ClassRegistrationField {
  id        String   @id @default(cuid())
  schoolId  String
  school    School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  key       String // slug used as the JSON key in ClassRegistration.customFieldValues — unique per-school, see @@unique below
  label     String
  fieldType String   @default("TEXT") // TEXT | SELECT
  options   Json? // string[] — choices shown when fieldType is SELECT, ignored otherwise
  required  Boolean  @default(false)
  order     Int      @default(0)
  enabled   Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([schoolId, key])
  @@index([schoolId])
}

model StaffAttendance {
  id                  String    @id @default(cuid())
  schoolId            String
  school              School    @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  userId              String
  user                User      @relation("StaffAttendances", fields: [userId], references: [id])
  date                DateTime
  session             Int       @default(1)
  status              String // PRESENT, LATE, ABSENT
  permissionType      String?
  permissionStartDate DateTime?
  permissionEndDate   DateTime?
  checkInTime         DateTime?
  checkOutTime        DateTime?
  markedById          String
  markedBy            User      @relation("StaffMarkedBy", fields: [markedById], references: [id])
  scanLatitude        Float? // GPS latitude at scan time
  scanLongitude       Float? // GPS longitude at scan time
  scanLocation        String? // Human-readable location label
  timestamp           DateTime  @default(now())

  @@unique([schoolId, userId, date, session])
  @@index([schoolId])
  @@index([date])
  @@index([userId, date])
  @@index([status])
  @@index([markedById])
}

model SessionConfig {
  id        String   @id @default(cuid())
  schoolId  String
  school    School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  classId   String? // null = global default for this school
  class     Class?   @relation(fields: [classId], references: [id])
  session   Int // 1=Morning1, 2=Morning2, 3=Afternoon1, 4=Afternoon2
  type      String // CHECK_IN or CHECK_OUT
  startTime String // HH:mm format e.g. "07:00"
  endTime   String // HH:mm format e.g. "07:15"
  scope     String   @default("CLASS") // CLASS or STAFF
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([schoolId, classId, session, scope])
  @@index([schoolId])
}

// Per-school weekly schedule for STAFF (one row per school, schoolId unique).
// Was a single global row (id = "default") pre-multi-tenancy.
// `schedule` is a JSON string: { MON:'same'|'day-off'|..., TUE:..., ..., SUN:... }
// Same value vocabulary as Class.schedule. 'day-off' days are excluded from
// staff attendance reports (not auto-marked ABSENT, not counted in totals).
model StaffWeeklySchedule {
  id        String   @id @default(cuid())
  schoolId  String   @unique
  school    School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  schedule  String
  updatedAt DateTime @updatedAt
}

model StudyYear {
  id         String    @id @default(cuid())
  schoolId   String
  school     School    @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  year       Int // e.g., 2026, 2027 — unique per-school, see @@unique below
  label      String? // e.g., "2026-2027"
  startDate  DateTime?
  endDate    DateTime?
  isCurrent  Boolean   @default(false)
  schoolName String? // e.g., "Wattaman International School"
  logoUrl    String? // base64 data URL or external URL
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  classes Class[]

  @@unique([schoolId, year])
  @@index([schoolId])
}

model Holiday {
  id          String   @id @default(cuid())
  schoolId    String
  school      School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  date        DateTime
  name        String
  description String?
  type        String   @default("HOLIDAY") // HOLIDAY, SCHOOL_EVENT, CUSTOM
  createdById String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([schoolId, date, name])
  @@index([schoolId])
  @@index([date])
}

model Department {
  id          String   @id @default(cuid())
  schoolId    String
  school      School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  name        String // Unique per-school, not globally — see @@unique below
  nameKh      String? // Khmer name
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  users User[]

  @@unique([schoolId, name])
  @@index([schoolId])
}

model RefreshToken {
  id        String   @id @default(cuid())
  // Not part of a uniqueness leak-vector concern (see the conversion plan's guiding
  // security principle) — `token` is a random opaque value, not a human-chosen
  // identifier, so it stays globally @unique. schoolId is carried for consistency
  // with every other tenant-scoped model, not for uniqueness enforcement.
  schoolId  String
  school    School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  token     String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([schoolId])
  @@index([userId])
  @@index([expiresAt])
}

// Single-use, short-lived token for the /auth/forgot-password → /auth/reset-password
// flow (Phase 2a). Deliberately a separate model from RefreshToken — different
// semantics (single-use, short TTL, one specific purpose) rather than overloading
// a session-token model with password-recovery meaning.
model PasswordResetToken {
  id        String    @id @default(cuid())
  schoolId  String
  school    School    @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  token     String    @unique
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([schoolId])
  @@index([userId])
  @@index([expiresAt])
}

// Phase 7a — paid add-ons with manual (invoice-outside-the-system) billing.
// One row per school per addon the platform has ever touched for that school;
// a school with no row for a given key is implicitly PENDING/disabled — see
// SchoolAddonsService.list(), which synthesizes a default entry for any
// canonical key with no row yet, rather than requiring a bootstrap row per
// school. `enabled` is the actual feature gate a future @RequiresAddon()
// consumer checks; `billingStatus` is bookkeeping for the platform admin and
// deliberately doesn't auto-drive `enabled` — a PLATFORM_ADMIN flips it
// explicitly, matching the plan's "manual toggle" billing model (no payment
// gateway in this phase).
model SchoolAddon {
  id              String          @id @default(cuid())
  schoolId        String
  school          School          @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  addonKey        String // references AddonDefinition.key, not .id — stable even if the catalog row's id changes
  addonDefinition AddonDefinition @relation(fields: [addonKey], references: [key])
  billingStatus   String          @default("PENDING") // PENDING | ACTIVE | OVERDUE | CANCELLED
  enabled         Boolean         @default(false)
  activatedAt     DateTime?
  activatedBy     String? // PLATFORM_ADMIN userId who last flipped `enabled`
  requestedAt     DateTime? // set when a school ADMIN requests a paid ADDON (Phase 10) — historical, not cleared on approval
  requestedBy     String? // that ADMIN's userId
  notes           String? // invoice ref / manual notes for the platform admin
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  @@unique([schoolId, addonKey])
  @@index([schoolId])
}

/// The Modules & Add-ons directory (Platform tier, WordPress-plugin-directory-
/// shaped): a platform-wide catalog a PLATFORM_ADMIN curates — create new
/// listings, price the paid ones, retire ones no longer offered — independent
/// of any one school. Not tenant-scoped (like School itself): this is the
/// same catalog every school browses, not a per-school row. `isActive: false`
/// is how "remove" works day-to-day (hides it from new browsing/enabling
/// without breaking schools that already have it — mirrors a plugin
/// directory delisting a plugin without uninstalling it from sites that
/// already run it); a real SQL DELETE is only allowed when zero SchoolAddon
/// rows reference it.
///
/// `kind` (Phase 9) distinguishes free, opt-in-at-creation MODULEs (e.g.
/// Attendance, Fee Management — no price, no billing lifecycle) from paid
/// opt-in-after-creation ADDONs (Phase 7a, e.g. Face Recognition Attendance —
/// priced, billingStatus-tracked on the SchoolAddon row). Both kinds share
/// this one table and SchoolAddon's per-school enablement rather than two
/// parallel systems — a MODULE row's `price`/`priceNote` just stay null, and
/// its SchoolAddon rows leave `billingStatus` at its unused default.
model AddonDefinition {
  id                String   @id @default(cuid())
  key               String   @unique // stable identifier, e.g. "FACE_RECOGNITION_ATTENDANCE" — set at creation, not editable after
  kind              String   @default("ADDON") // MODULE | ADDON | THEME
  name              String
  description       String? // short blurb, shown in listing cards
  detailDescription String? // long-form write-up for the platform admin's own detail view — separate from `description` so the card summary can stay short
  screenshotUrl     String? // base64 data URL or external URL, same convention as other image fields (Student.photo, Class.thumbnail, etc.) — no server-side file storage in this app
  category          String?
  icon              String? // a single emoji, kept simple
  price             Float?
  priceNote         String? // free text, e.g. "/month", "one-time" — billing itself stays manual (Phase 7a), this is just the listed price
  isActive          Boolean  @default(true)
  // THEME-only preset payload — { mode: 'light'|'dark', accentColor: AccentColor, primaryColor: string }.
  // Force-nulled server-side for non-THEME kinds, same convention as price/priceNote being
  // force-nulled for MODULE (see addon-directory.service.ts).
  themeConfig       Json?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  schoolAddons SchoolAddon[]
}

/// Stable platform-global identity for an installable extension. This lives
/// alongside AddonDefinition during the compatibility rollout; legacyAddonKey
/// links the records without changing current school feature gates.
model Extension {
  id              String             @id @default(cuid())
  key             String             @unique
  name            String
  description     String?
  runtimeType     String // CORE_MODULE | DECLARATIVE_MODULE | THEME | INTEGRATION | CODE_EXTENSION
  commercialType  String // MODULE | ADDON | THEME
  category        String?
  publisher       String             @default("WATTAMAN")
  publisherId     String
  publisherEntity ExtensionPublisher @relation(fields: [publisherId], references: [id], onDelete: Restrict)
  status          String             @default("ACTIVE") // ACTIVE | SUSPENDED | RETIRED
  isListed        Boolean            @default(false)
  legacyAddonKey  String?            @unique
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  versions      ExtensionVersion[]
  installations ExtensionInstallation[]
  records       ExtensionRecord[]
  dependencies  ExtensionDependency[]   @relation("ExtensionDependencies")
  requiredBy    ExtensionDependency[]   @relation("RequiredExtensionDependencies")

  @@index([runtimeType, status])
  @@index([commercialType, isListed])
  @@index([publisherId, status])
}

model ExtensionPublisher {
  id           String   @id @default(cuid())
  key          String   @unique
  name         String
  status       String   @default("ACTIVE") // ACTIVE | SUSPENDED | REVOKED
  internal     Boolean  @default(true)
  contactEmail String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  extensions Extension[]
  members    ExtensionPublisherMember[]

  @@index([status, internal])
}

model ExtensionPublisherMember {
  id          String             @id @default(cuid())
  publisherId String
  publisher   ExtensionPublisher @relation(fields: [publisherId], references: [id], onDelete: Cascade)
  userId      String
  user        User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  roles       Json
  status      String             @default("ACTIVE") // ACTIVE | SUSPENDED
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt

  @@unique([publisherId, userId])
  @@index([userId, status])
}

/// Immutable release metadata. Published rows must never be updated in-place;
/// lifecycle services enforce that rule and create a new semantic version.
model ExtensionVersion {
  id                 String    @id @default(cuid())
  extensionId        String
  extension          Extension @relation(fields: [extensionId], references: [id], onDelete: Cascade)
  version            String
  manifestSchema     Int       @default(1)
  manifest           Json
  packageStorageKey  String?
  packageChecksum    String?
  packageSize        Int?
  compatibilityRange String?
  lifecycleStatus    String    @default("UPLOADED") // UPLOADED | QUARANTINED | VALIDATING | VALIDATED | REJECTED | AWAITING_REVIEW | APPROVED | PUBLISHED | DEPRECATED | BLOCKED | RETIRED
  reviewNotes        String?
  releaseNotes       String?
  uploadedBy         String?
  reviewedBy         String?
  publishedAt        DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  assets        ExtensionAsset[]
  permissions   ExtensionPermission[]
  validations   ExtensionValidation[]
  installations ExtensionInstallation[]
  reviews       ExtensionReview[]

  @@unique([extensionId, version])
  @@index([extensionId, lifecycleStatus])
  @@index([lifecycleStatus, createdAt])
  @@index([packageChecksum])
}

model ExtensionReview {
  id                 String           @id @default(cuid())
  extensionVersionId String
  extensionVersion   ExtensionVersion @relation(fields: [extensionVersionId], references: [id], onDelete: Cascade)
  action             String // SUBMITTED | APPROVED | REJECTED | APPEALED
  notes              String?
  actorId            String?
  actorRole          String?
  createdAt          DateTime         @default(now())

  @@index([extensionVersionId, createdAt])
  @@index([action, createdAt])
}

model ExtensionAsset {
  id                 String           @id @default(cuid())
  extensionVersionId String
  extensionVersion   ExtensionVersion @relation(fields: [extensionVersionId], references: [id], onDelete: Cascade)
  path               String
  storageKey         String
  checksum           String
  mimeType           String
  size               Int
  createdAt          DateTime         @default(now())

  @@unique([extensionVersionId, path])
  @@index([extensionVersionId])
}

model ExtensionPermission {
  id                 String           @id @default(cuid())
  extensionVersionId String
  extensionVersion   ExtensionVersion @relation(fields: [extensionVersionId], references: [id], onDelete: Cascade)
  capability         String
  description        String?
  sensitive          Boolean          @default(false)
  createdAt          DateTime         @default(now())

  @@unique([extensionVersionId, capability])
  @@index([capability])
}

model ExtensionDependency {
  id                  String    @id @default(cuid())
  extensionId         String
  extension           Extension @relation("ExtensionDependencies", fields: [extensionId], references: [id], onDelete: Cascade)
  requiredExtensionId String
  requiredExtension   Extension @relation("RequiredExtensionDependencies", fields: [requiredExtensionId], references: [id], onDelete: Restrict)
  versionRange        String?
  optional            Boolean   @default(false)
  createdAt           DateTime  @default(now())

  @@unique([extensionId, requiredExtensionId])
  @@index([requiredExtensionId])
}

model ExtensionValidation {
  id                 String           @id @default(cuid())
  extensionVersionId String
  extensionVersion   ExtensionVersion @relation(fields: [extensionVersionId], references: [id], onDelete: Cascade)
  status             String // RUNNING | PASSED | FAILED | TIMED_OUT
  errors             Json?
  warnings           Json?
  validatorVersion   String?
  startedAt          DateTime         @default(now())
  completedAt        DateTime?

  @@index([extensionVersionId, startedAt])
  @@index([status, startedAt])
}

/// Tenant-owned installation state. This model is included in
/// TENANT_SCOPED_MODELS so every normal request is automatically school-bound.
model ExtensionInstallation {
  id                 String           @id @default(cuid())
  schoolId           String
  school             School           @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  extensionId        String
  extension          Extension        @relation(fields: [extensionId], references: [id], onDelete: Restrict)
  installedVersionId String
  installedVersion   ExtensionVersion @relation(fields: [installedVersionId], references: [id], onDelete: Restrict)
  enabled            Boolean          @default(false)
  configuration      Json?
  billingStatus      String           @default("PENDING")
  requestedBy        String?
  requestedAt        DateTime?
  approvedBy         String?
  approvedAt         DateTime?
  installedBy        String?
  installedAt        DateTime?
  uninstalledAt      DateTime?
  purgeAfter         DateTime?
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt

  @@unique([schoolId, extensionId])
  @@index([schoolId, enabled])
  @@index([extensionId, installedVersionId])
  @@index([purgeAfter])
}

/// Generic tenant-scoped records for declarative modules. The platform owns
/// storage and validation; packages only declare resource schemas.
model ExtensionRecord {
  id          String    @id @default(cuid())
  schoolId    String
  school      School    @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  extensionId String
  extension   Extension @relation(fields: [extensionId], references: [id], onDelete: Cascade)
  resource    String
  data        Json
  createdBy   String?
  updatedBy   String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([schoolId, extensionId, resource, createdAt])
  @@index([extensionId, resource])
}

/// Append-only audit trail of every privileged action in the system.
/// Designed for compliance + forensics: actor identity is denormalized so
/// the record survives even if the user is later deleted.
model AuditLog {
  id        String   @id @default(cuid())
  schoolId  String // Every request already resolves a school before auth runs (Phase 2's
  // TenantHostMiddleware), including PLATFORM_ADMIN traffic on the reserved platform
  // host (resolves to the sentinel School) — so this is never null in practice.
  school    School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  // ── Who ──
  actorId    String? // null for anonymous / system events (e.g. failed login attempt)
  actorRole  String?
  actorName  String? // denormalized snapshot
  actorEmail String? // denormalized snapshot

  // ── What ──
  // High-level verb. Suggested set: CREATE, READ, UPDATE, DELETE, LOGIN,
  // LOGIN_FAILED, LOGOUT, EXPORT, IMPORT, ROLE_CHANGE, PASSWORD_RESET,
  // PERMISSION_CHANGE, BACKUP, RESTORE, IMPERSONATION_START, IMPERSONATION_END.
  action        String
  // Resource type, e.g. USER, STUDENT, CLASS, ATTENDANCE, CARD_TEMPLATE,
  // EXAM, FEE, SALARY, ANNOUNCEMENT, BACKUP, SETTINGS, SCHOOL, etc.
  resource      String
  resourceId    String?
  resourceLabel String? // human-readable snapshot (e.g. student name)

  // ── Detail ──
  changes  Json? // { before: {...}, after: {...} } or array of diffs
  metadata Json? // arbitrary structured context

  // ── Request context ──
  method     String? // HTTP method
  path       String? // request path
  statusCode Int?
  ip         String?
  userAgent  String?

  // ── Outcome ──
  success      Boolean @default(true)
  errorMessage String?

  @@index([schoolId, createdAt])
  @@index([createdAt])
  @@index([actorId, createdAt])
  @@index([resource, resourceId, createdAt])
  @@index([action, createdAt])
}

/// Stores admin-configured schedules for automatic audit log cleanup. Per-school —
/// each school's admin sets their own retention policy.
model AuditCleanupSchedule {
  id        String   @id @default(cuid())
  schoolId  String
  school    School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// Human-readable label, e.g. "Daily – keep 90 days"
  label String

  /// How often to run: HOURLY | DAILY | WEEKLY | MONTHLY
  frequency String

  /// Number of days of logs to retain (older entries are deleted)
  retainDays Int

  /// Whether this schedule is active
  enabled Boolean @default(true)

  /// ISO timestamp of the last successful run (null = never ran)
  lastRunAt DateTime?

  /// Number of rows deleted in the last run
  lastDeletedCount Int @default(0)

  @@index([schoolId])
  @@index([enabled])
}

/// Daily rollup of a school's activity/latency, one row per school per
/// finalized (past) day. Populated by a nightly cron (SchoolMetricsService),
/// not read from AuditLog live — this decouples usage history from each
/// school's own AuditCleanupSchedule retention, which can be as short as a
/// few days and hard-deletes old AuditLog rows.
model SchoolDailyMetric {
  id       String   @id @default(cuid())
  schoolId String
  school   School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  date     DateTime // UTC midnight — the day this row summarizes

  /// Count of tracked (mutating) AuditLog events that day.
  requestCount    Int    @default(0)
  /// Of those, how many had success: false.
  errorCount      Int    @default(0)
  avgDurationMs   Float?
  p95DurationMs   Float?
  /// Distinct actorId count that day.
  activeUserCount Int    @default(0)
  /// Snapshot (not a daily delta) of total bytes stored across all base64 image/logo/design
  /// columns for this school, as of computedAt — see SchoolMetricsService for the exact column list.
  storageBytes    BigInt @default(0)

  computedAt DateTime @default(now())

  @@unique([schoolId, date])
  @@index([date])
}

model CardTemplate {
  id        String   @id @default(cuid())
  schoolId  String
  school    School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  name      String
  cardType  String // "student" or "staff"
  design    Json // full CardDesign JSON
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([schoolId])
}

model AttendanceFormatRule {
  id                         String   @id @default(cuid())
  schoolId                   String
  school                     School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  scope                      String // CLASS or STAFF
  organizationId             String?
  permissionsPerAbsent       Int      @default(3) // X permissions = 1 absent full day
  latesPerAbsentHalf         Int      @default(3) // X lates = 1 absent half day
  // Daily "Mostly Absent" rule: if a person is ABSENT in >= N sessions of the day,
  // the whole day is counted as ABSENT even if some sessions are PRESENT/LATE.
  // 0 = disabled. Default 3 (out of 4 sessions).
  absentSessionsForDayAbsent Int      @default(3)
  // Grace minutes after a teacher's period start before their wattaman scan
  // is marked LATE instead of PRESENT. Default 20 minutes.
  teacherLateGraceMinutes    Int      @default(20)
  caseStudyABEnabled         Boolean  @default(true)
  enabled                    Boolean  @default(false)
  createdAt                  DateTime @default(now())
  updatedAt                  DateTime @updatedAt

  @@unique([schoolId, scope, organizationId])
  @@index([schoolId])
}

// ─── Fee Management ───────────────────────────────────────────────────────────

model FeeRecord {
