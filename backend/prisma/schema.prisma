  studentId      String
  student        Student  @relation(fields: [studentId], references: [id])
  totalAmount    Float
  discount       Float    @default(0)
  discountReason String?
  paidAmount     Float    @default(0)
  dueDate        DateTime
  term           String?
  subject        String? // e.g. "Math", "English" — which lesson this fee is for
  feeClass       String? // class name override (e.g. extra-curricular class)
  notes          String?
  createdById    String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  payments FeePayment[]

  @@index([schoolId])
  @@index([studentId])
}

model FeePayment {
  id          String    @id @default(cuid())
  schoolId    String
  school      School    @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  feeRecordId String
  feeRecord   FeeRecord @relation(fields: [feeRecordId], references: [id], onDelete: Cascade)
  amount      Float
  note        String?
  createdById String
