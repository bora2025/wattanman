{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://wattaman.app/schemas/extension-manifest-v1.schema.json",
  "title": "Wattaman Declarative Extension Manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "key", "name", "version", "runtimeType", "permissions", "navigation", "pages", "resources"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "key": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]{1,63}$" },
    "name": { "type": "string", "minLength": 1, "maxLength": 120 },
    "version": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+(?:-[0-9A-Za-z.-]+)?$" },
    "runtimeType": { "const": "DECLARATIVE_MODULE" },
    "permissions": { "type": "array", "uniqueItems": true, "items": { "type": "string", "pattern": "^[a-z][a-z0-9_-]*:(read|write)$" } },
    "navigation": { "type": "array", "items": { "type": "object", "required": ["label", "pageKey", "roles"], "properties": { "label": { "type": "string" }, "pageKey": { "type": "string" }, "icon": { "type": "string" }, "section": { "type": "string" }, "roles": { "type": "array", "items": { "type": "string" } } } } },
    "pages": { "type": "array", "minItems": 1 },
    "resources": { "type": "object", "minProperties": 1 },
    "assets": { "type": "array", "items": { "type": "string" } },
    "dependencies": { "type": "array", "uniqueItems": true, "items": { "type": "object", "additionalProperties": false, "required": ["key", "optional"], "properties": { "key": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]{1,63}$" }, "versionRange": { "type": "string", "pattern": "^(?:>=|>)\\d+\\.\\d+\\.\\d+(?:\\s+(?:<=|<)\\d+\\.\\d+\\.\\d+)?$" }, "optional": { "type": "boolean" } } } },
    "conflicts": { "type": "array", "uniqueItems": true, "items": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]{1,63}$" } },
    "migrations": { "type": "array", "items": { "type": "object", "additionalProperties": false, "required": ["fromVersion", "toVersion", "operations"], "properties": { "fromVersion": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$" }, "toVersion": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$" }, "operations": { "type": "array", "minItems": 1, "items": { "oneOf": [ { "type": "object", "additionalProperties": false, "required": ["type", "resource", "from", "to"], "properties": { "type": { "const": "renameField" }, "resource": { "type": "string" }, "from": { "type": "string" }, "to": { "type": "string" } } }, { "type": "object", "additionalProperties": false, "required": ["type", "resource", "field", "value"], "properties": { "type": { "const": "setDefault" }, "resource": { "type": "string" }, "field": { "type": "string" }, "value": {} } }, { "type": "object", "additionalProperties": false, "required": ["type", "resource", "field"], "properties": { "type": { "const": "removeField" }, "resource": { "type": "string" }, "field": { "type": "string" } } } ] } } } }
  },
  "patternProperties": { "^x-": true }
}
