# Backend API base URL. Server-side proxy route (app/api/[...path]/route.ts) uses API_URL first,
# falling back to NEXT_PUBLIC_API_URL; client-side code (Sidebar, messageSocket, etc.) uses
# NEXT_PUBLIC_API_URL directly since it must be available in the browser bundle.
API_URL=http://localhost:3001
NEXT_PUBLIC_API_URL=http://localhost:3001

# Multi-tenancy — must match backend's PLATFORM_HOST. Used by frontend/middleware.ts to decide
# whether the current request is platform traffic or a school subdomain/custom domain.
PLATFORM_HOST=app.wattaman.app

# Must match backend's SCHOOL_ROOT_DOMAIN. NEXT_PUBLIC_ because the Platform "Impersonate"
# button (frontend/app/platform/schools/[id]/page.tsx) builds a school's subdomain URL
# client-side to open the session bridge (frontend/app/session-bridge/page.tsx).
NEXT_PUBLIC_SCHOOL_ROOT_DOMAIN=wattaman.app

PORT=3000
