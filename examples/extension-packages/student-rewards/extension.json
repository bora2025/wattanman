{
  "schemaVersion": 1,
  "key": "STUDENT_REWARDS",
  "name": "Student Rewards",
  "version": "1.0.0",
  "runtimeType": "DECLARATIVE_MODULE",
  "permissions": ["rewards:read", "rewards:write"],
  "navigation": [
    {
      "label": "Student Rewards",
      "pageKey": "rewards",
      "icon": "trophy",
      "section": "Extensions",
      "roles": ["ADMIN", "TEACHER"]
    }
  ],
  "pages": [
    {
      "key": "rewards",
      "title": "Student Rewards",
      "resource": "rewards",
      "roles": ["ADMIN", "TEACHER"],
      "fields": [
        { "key": "studentName", "label": "Student", "type": "text", "required": true },
        { "key": "points", "label": "Points", "type": "number", "required": true },
        { "key": "reason", "label": "Reason", "type": "text", "required": true },
        { "key": "awardedOn", "label": "Awarded on", "type": "date", "required": true }
      ],
      "ariaLabel": "Student rewards management",
      "components": [
        { "type": "stats", "title": "Reward summary", "metrics": [{ "key": "awards", "label": "Awards", "aggregate": "count" }, { "key": "points", "label": "Total points", "aggregate": "sum", "field": "points" }] },
        { "type": "form", "title": "Award points", "actions": ["create", "update"] },
        { "type": "chart", "title": "Points by student", "categoryField": "studentName", "valueField": "points", "aggregate": "sum" },
        { "type": "table", "title": "Reward history", "columns": ["studentName", "points", "reason", "awardedOn"], "actions": ["view", "edit", "delete"], "searchable": true },
        { "type": "details", "title": "Reward details", "fields": ["studentName", "points", "reason", "awardedOn"] }
      ]
    }
  ],
  "resources": {
    "rewards": {
      "fields": [
        { "key": "studentName", "type": "text", "required": true },
        { "key": "points", "type": "number", "required": true },
        { "key": "reason", "type": "text", "required": true },
        { "key": "awardedOn", "type": "date", "required": true }
      ]
    }
  },
  "defaultLocale": "en",
  "translations": {
    "en": {},
    "km": {}
  }
}
